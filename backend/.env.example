# ==============================================================================
# CampusVault Backend Environment Template (Render / Cloud Deployment)
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=8080

# Production Cloud MySQL Database (e.g. Aiven, TiDB, Clever Cloud, Railway)
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/campusvault?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JWT Secret (At least 64 hex characters or 32 alphanumeric bytes)
JWT_SECRET=4c616d7075735661756c745365637572654a77745365637265744b657932303236303432314175576562
JWT_EXPIRATION_MS=86400000

# Frontend Base URL (Your Vercel deployment URL for QR verification links)
FRONTEND_BASE_URL=https://campusvault.vercel.app

# Allowed CORS Origins (Vercel domain and preview branches)
CORS_ALLOWED_ORIGINS=https://campusvault.vercel.app,https://*.vercel.app,http://localhost:5173

# Optional: Initial Admin Seed Credentials
ADMIN_INIT_EMAIL=admin@campusvault.edu
ADMIN_INIT_PASSWORD=Admin@123
ADMIN_INIT_NAME=Dean of Academic Records
SEED_SAMPLE_DATA=true
